---
# Two suppressions, both deliberate; everything else must pass, because
# `make lint` fails when ansible-lint fails.

exclude_paths:
  # Generated per build and gitignored; its long ProxyCommand line trips
  # yaml[line-length] and no human gets to reflow it.
  - ansible/inventory/hosts.generated.yaml

skip_list:
  # Facts here are prefixed `anon_` (per lab), not `<role>_` (per role), so a
  # fact means the same thing wherever it was set.
  - var-naming[no-role-prefix]

  # /etc/motd is written from a `|+` scalar whose trailing newlines ARE the gap
  # before the login prompt. Trimming them to satisfy yamllint changes the
  # banner on every host.
  - yaml[empty-lines]
