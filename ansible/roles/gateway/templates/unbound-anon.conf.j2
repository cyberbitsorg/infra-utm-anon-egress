# Managed by Ansible (role: gateway). Do not edit on the host.
#
# The workstation's only resolver: it listens on the internal segment and
# loopback, NEVER the WAN NIC, and forwards only to Mullvad's in-tunnel
# resolver. A fragment in unbound.conf.d/, included last, so it wins over
# Debian's defaults.
server:
    # Pinned to drop subnetcache, which unbound 1.22 enables by default: ECS
    # tells an upstream which network the client is on, the one fact to withhold.
    module-config: "validator iterator"

    interface: {{ internal_ip }}
    interface: 127.0.0.1
    port: 53

    # Bind the internal address even if it is not up yet: unbound.service is
    # ordered After=network.target, which does not mean addresses are assigned,
    # and a boot that loses that race would leave the workstation resolverless.
    ip-freebind: yes

    # Only the isolated segment and the gateway itself may query.
    access-control: 0.0.0.0/0 refuse
    access-control: {{ lab_segment }} allow
    access-control: 127.0.0.0/8 allow

    do-ip4: yes
    do-udp: yes
    do-tcp: yes
    # The ip6 tables are policy drop, so a v6 query is a guaranteed timeout.
    do-ip6: no

    hide-identity: yes
    hide-version: yes
    do-not-query-localhost: yes

    # Query logs on an anonymity gateway would build exactly the record this
    # repo exists to avoid.
    verbosity: 0
    log-queries: no
    log-replies: no
    use-syslog: yes

    qname-minimisation: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    prefetch: yes

# No fallback forwarder: a second, clear-net one would be a DNS leak by design.
forward-zone:
    name: "."
    forward-addr: {{ mullvad_dns }}
