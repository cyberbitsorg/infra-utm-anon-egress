#!/usr/sbin/nft -f
# Managed by Ansible (role: gateway). Do not edit on the host.
#
# The fail-closed kill-switch: three chains at policy drop, and exactly two
# ways out -- WireGuard-encrypted UDP to ONE endpoint, and anything already
# inside the tunnel. Fail-closed comes from ORDERING, not from a hook:
# nftables.service loads this before wg-quick, so a tunnel that never comes up
# leaves forwarding that was never permitted. There is no window to miss.
#
# Every interface name comes from a fact derived on the host (see
# tasks/wireguard.yaml); hardcoding them would read correctly and leak the day
# the kernel renames a NIC.

# Replace ONLY our own tables, never `flush ruleset`: that also destroys
# `table ip wg-quick-wg0`, which wg-quick uses to mark its own packets. Losing
# it fails closed but kills the tunnel completely, on every reload of this
# file. The bare `table` line before each `delete` creates it if absent, so the
# delete cannot fail on a fresh boot; the whole file still applies atomically.
table inet filter
delete table inet filter
table ip nat
delete table ip nat
table ip6 filter
delete table ip6 filter

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept

    # Management SSH, INBOUND over the SLIRP host port forward. Not reachable
    # from the internet and it cannot carry workstation traffic outward, so it
    # is not a leak -- and it is the repair path when the tunnel is broken.
    iifname "{{ anon_wan_if }}" tcp dport 22 accept

    # The workstation: SSH (ProxyJump target), DNS to unbound, and ICMP.
    iifname "{{ anon_internal_if }}" tcp dport 22 accept
    iifname "{{ anon_internal_if }}" udp dport 53 accept
    iifname "{{ anon_internal_if }}" tcp dport 53 accept
    iifname "{{ anon_internal_if }}" icmp type echo-request accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    # unbound is the workstation's ONLY resolver. Without these two rules the
    # accept below would forward a query to 1.1.1.1 into the tunnel: not an IP
    # leak (the exit is the source), but it hands a third party the full query
    # stream and routes around every policy unbound enforces. Queries to
    # unbound itself are addressed to the gateway and land in the input chain.
    iifname "{{ anon_internal_if }}" udp dport 53 drop
    iifname "{{ anon_internal_if }}" tcp dport 53 drop

    # The ONLY forward path. internal -> WAN is not expressed at all; policy
    # drop covers it. If wg0 does not exist this rule matches nothing and the
    # workstation has no egress, which is the entire promise.
    iifname "{{ anon_internal_if }}" oifname "{{ wg_interface }}" accept

    # Return traffic, and ONLY tunnel -> internal.
    #
    # This was once an unqualified `ct state established,related accept`, which
    # was a clear-net leak: conntrack keys on the IP 5-tuple, NOT the output
    # interface, so an entry created while the tunnel was up stays ESTABLISHED
    # for five days after it goes away. That is reachable, not theoretical --
    # wg-quick's del_if() removes its policy routes BEFORE the interface, so
    # there is a window where the effective route is already the WAN. Requiring
    # `iifname {{ wg_interface }}` closes it by construction: with the tunnel
    # gone, no packet can carry that input interface.
    iifname "{{ wg_interface }}" oifname "{{ anon_internal_if }}" ct state established,related accept
  }

  chain output {
    type filter hook output priority 0; policy drop;

    oif lo accept

    # There is deliberately NO unqualified `ct state established,related
    # accept` here, for the same reason it was removed from the forward chain.
    # That it happens not to leak today is an accident of the gateway's sockets
    # being bound to wg0's source address; accidents are not security
    # properties, so every accept below names its interface.

    # The single clear-net exception: WireGuard to ONE endpoint, pinned to an
    # IP so no DNS is needed to bring the tunnel up. No state match: this rule
    # intentionally covers the whole flow.
    oifname "{{ anon_wan_if }}" ip daddr {{ mullvad_endpoint_ip }} udp dport {{ mullvad_endpoint_port }} accept

    # Replies to the inbound management SSH, scoped to source port 22 so it
    # cannot carry anything else out. Originating a new flow from sport 22 is
    # root-only and would still need an inbound packet first.
    #
    # DELIBERATELY STATELESS, unlike every other accept here. conntrack only
    # starts tracking when a ruleset referencing `ct` is first loaded -- on a
    # cold build that moment is mid-play, while Ansible is already connected.
    # That in-flight connection has no conntrack entry, so its replies failed
    # `ct state established`, were dropped along with the RST, and `make up`
    # hung forever at that exact task. Being unable to lock yourself out of the
    # repair path is worth more than the marginal tightening.
    oifname "{{ anon_wan_if }}" tcp sport 22 accept

    # The gateway must be able to ORIGINATE one thing on the internal segment:
    # TCP to port 22. `ssh -W` makes sshd here open a brand-new connection out
    # the internal NIC, which `ct state established` does not cover -- without
    # this rule the workstation play, `make verify` and `make ssh workstation`
    # all fail. Not a leak: the segment is host-only with no route anywhere,
    # and the forward chain still denies internal -> WAN.
    oifname "{{ anon_internal_if }}" tcp dport 22 accept

    # Replies to the workstation: unbound's answers, sshd's answers, ICMP echo
    # replies. Scoped to the internal NIC.
    oifname "{{ anon_internal_if }}" ct state established,related accept

    # Everything else the gateway does goes through the tunnel, including apt
    # and unbound's upstream queries. With the tunnel down it can update
    # neither -- accepted deliberately: a clear-net exception on the anonymity
    # layer would be a permanent leak path.
    oifname "{{ wg_interface }}" accept
  }
}

table ip nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    # SNAT the workstation's traffic, but only as it leaves the tunnel.
    oifname "{{ wg_interface }}" masquerade
  }
}

# IPv6 is dropped outright rather than tunnelled: strictly less leak surface,
# and nothing here needs v6.
table ip6 filter {
  chain input   { type filter hook input priority 0; policy drop; }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output  { type filter hook output priority 0; policy drop; }
}
