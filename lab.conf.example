# infra-utm-anon-egress build configuration.
# Copy to lab.conf and adjust. lab.conf is gitignored; secrets go in .env.

# --- Identity ---------------------------------------------------------------
# Prefix for all VM names in UTM (the gateway becomes "anon-gateway").
LAB_PREFIX="anon"

# User created inside every VM; Ansible connects as this user. Avoid a name
# that is already a system group in the guest (operator, staff, games, users).
LAB_USER="anon"

# Public SSH key injected into every VM. `make preflight` generates one if the
# file does not exist.
LAB_SSH_KEY="${HOME}/.ssh/id_ed25519_anon.pub"

# --- Networking -------------------------------------------------------------
# The NIC layout is per role and deliberately NOT configurable here, because
# the security property depends on it: the gateway gets NAT plus the internal
# segment, everything else gets ONLY the internal NIC and so has no path out
# except through the gateway (scripts/lib.sh, nic_layout_for_role).
LAB_SEGMENT="10.20.0.0/24"
GATEWAY_INTERNAL_IP="10.20.0.1"
WORKSTATION_INTERNAL_IP="10.20.0.10"

# The vmnet host-only SWITCH has its own subnet, assigned by macOS and separate
# from LAB_SEGMENT. A live route whose gateway falls inside it (classically a
# VPN's) gets bound to UTM's bridge instead and silently disappears. macOS
# will not reliably let you move it, so declare what the bridge actually uses
# and let `make preflight` refuse to build while a route collides; the fix is
# to bring the VPN or the VMs down first. See README "Host-only subnet".
HOST_ONLY_SUBNET="192.168.128.0/24"

# --- Resource defaults ------------------------------------------------------
# Per-VM cpu= / ram= / disk= fields in LAB_VMS override these.
LAB_CPU=2
LAB_RAM=2048
LAB_DISK_GB=20

# --- Base images (ARM64 / aarch64) ------------------------------------------
# The gateway runs Debian, the workstation Kali (chosen per role in
# scripts/lib.sh, role_image).
#
# "generic", NOT "genericcloud": the cloud kernel has no DRM drivers, so UTM's
# display stays dead. A few hundred MB more for a working console from first
# boot. Debian publishes SHA512SUMS, hence DEBIAN_SHA_ALGO.
#
# The release name is in the path, so moving releases means changing both URLs
# together; "latest" is a rolling pointer within one release.
DEBIAN_IMG_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-arm64.qcow2"
DEBIAN_SHA_URL="https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS"
DEBIAN_SHA_ALGO=512

# Kali ships a .tar.xz holding a raw disk that fetch-images.sh verifies and
# extracts. It is ~25 GiB, already larger than LAB_DISK_GB, and never shrunk.
# The URLs use the per-release directory, not current/, which 404s the moment
# Kali cuts a release. Releases: https://kali.download/cloud-images/
KALI_VERSION="2026.3"
KALI_IMG_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/kali-linux-${KALI_VERSION}-cloud-genericcloud-arm64.tar.xz"
KALI_SHA_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/SHA256SUMS"
KALI_IMG_FILE="kali-genericcloud-arm64.raw"

# --- Kali toolset -----------------------------------------------------------
# Which Kali function groups the workstation gets, WITHOUT the kali-tools-
# prefix. Separate with spaces or commas, so the list below can be pasted as
# is. Empty (the default) is a bare Kali with the desktop and Mullvad Browser.
#
# Everything downloads through the tunnel, which is the point and also why it
# is slow: 2 to 650 packages per group (gpu 2, detect 11, passwords 279,
# top10 301, web 609, vulnerability 650). Selecting all of them is hours of
# apt over a multihop VPN and tens of GB -- raise disk= to match.
#
# Groups: 802-11, bluetooth, crypto-stego, database, detect, exploitation,
# forensics, fuzzing, gpu, hardware, identify, information-gathering,
# passwords, post-exploitation, protect, recover, reporting, respond,
# reverse-engineering, rfid, sdr, sniffing-spoofing, social-engineering,
# top10, voip, vulnerability, web, windows-resources, wireless.
#
# The kali-linux-* umbrellas are deliberately NOT selectable: all four pull
# openvpn and vpnc onto a host that must never hold a VPN client. sdr, rfid,
# bluetooth, hardware and 802-11 install fine but have no device to talk to.
KALI_TOOL_GROUPS=""

# --- Host clipboard ----------------------------------------------------------
# Share the clipboard between the Mac and the workstation desktop (SPICE agent;
# UTM's half is already on). "yes" or "no"; empty means no.
#
# It does NOT weaken the network invariant: virtio-serial is not a route, and
# the tunnel, DNS and kill-switch are untouched. What it costs is
# compartmentalisation, in three concrete ways:
#
#   1. Universal Clipboard (Handoff) syncs the Mac's clipboard to your iPhone
#      via iCloud, i.e. to your Apple ID. This is the one that can genuinely
#      deanonymise you. Turn Handoff off before enabling this.
#   2. Clipboard managers (Raycast, Alfred, Maccy, Paste) persist clipboard
#      history to disk on the host, where it outlives 'make destroy' and
#      defeats the workstation's disposability.
#   3. Wrong paste direction: with a bridge in place you can paste something
#      identity-linked INTO the anonymous session out of muscle memory. That
#      channel does not exist until you enable this.
#
# 1 and 2 are host settings you can fix. 3 is yours to manage.
WORKSTATION_CLIPBOARD="no"

# --- VM fleet ---------------------------------------------------------------
# Each entry: "name:role [cpu=N] [ram=MiB] [disk=GB]"
#
#   name   the UTM VM is LAB_PREFIX-name; 'make ssh' and the inventory use it
#   role   picks the base image, NIC layout, cloud-init seed and Ansible group
#
# The gateway MUST be first: its host SSH port is 2300+index, and both the
# workstation's ProxyJump and verify.sh derive it from index 1.
#
# cpu= and ram= changes restart that VM on the next 'make up'. disk= applies
# only at creation, so growing one means 'make destroy' then 'make up'.
LAB_VMS=(
  "gateway:gateway cpu=2 ram=2048 disk=20"
  "workstation:workstation cpu=4 ram=4096 disk=60"
)
