# infra-utm-anon-egress build configuration.
# Copy to lab.conf and adjust. lab.conf is gitignored; secrets go in .env.

# --- Identity ---------------------------------------------------------------
# Prefix for all VM names in UTM (the gateway becomes "anon-gateway").
LAB_PREFIX="anon"

# User created inside every VM by cloud-init; Ansible connects as this user.
# Avoid a name that is already a system group in the guest (operator, staff,
# games, users): the template handles the clash, but a free name is simpler.
LAB_USER="anon"

# Public SSH key injected into every VM. `make preflight` generates one if the
# file does not exist.
LAB_SSH_KEY="${HOME}/.ssh/id_ed25519_anon.pub"

# --- Networking -------------------------------------------------------------
# The NIC layout is per role and NOT configurable here, because the security
# property depends on it (scripts/lib.sh, nic_layout_for_role):
#
#   gateway      dual     an emulated NAT NIC (internet + the host SSH forward)
#                         AND a host-mode NIC at GATEWAY_INTERNAL_IP.
#   everything   internal ONLY a host-mode NIC on LAB_SEGMENT: no NAT NIC, so
#   else                  no path to the internet except through the gateway.
#                         Reached from the host by ProxyJump, never a forward.
LAB_SEGMENT="10.20.0.0/24"
GATEWAY_INTERNAL_IP="10.20.0.1"

# The vmnet host-only SWITCH has its own subnet, assigned by macOS (default
# 192.168.128.0/24) and separate from LAB_SEGMENT above. It matters because a
# live route whose gateway falls inside it -- classically a VPN's -- gets bound
# to UTM's bridge instead, and that traffic silently disappears.
#
# On current macOS the subnet cannot reliably be moved, so declare what the
# bridge actually uses here and let `make preflight` refuse to build while a
# route collides. The fix is operational: bring the VPN (or the VMs) down
# first. See README "Host-only subnet".
HOST_ONLY_SUBNET="192.168.128.0/24"

# --- Resource defaults ------------------------------------------------------
# Per-VM cpu= / ram= / disk= fields in LAB_VMS override these.
LAB_CPU=2
LAB_RAM=2048
LAB_DISK_GB=20

# --- Base images (ARM64 / aarch64) ------------------------------------------
# The gateway runs Debian, the workstation Kali (chosen per role in
# scripts/lib.sh, role_image).
#
# Debian's "generic" variant, NOT "genericcloud": genericcloud ships the
# cut-down cloud kernel, which has no DRM drivers, so UTM's display stays dead
# ("Display output is not active"). "generic" costs a few hundred MB more and
# gives a working console from first boot. Debian publishes SHA512SUMS, hence
# DEBIAN_SHA_ALGO.
#
# trixie (Debian 13) is current stable. The suite name is in the path, so
# moving releases means changing both URLs together; "latest" within a release
# is a rolling pointer to that release's newest build, and fetch-images.sh
# re-verifies the image against the SHA512SUMS it fetches alongside it.
DEBIAN_IMG_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-arm64.qcow2"
DEBIAN_SHA_URL="https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS"
DEBIAN_SHA_ALGO=512

# Kali ships a .tar.xz containing a raw disk; fetch-images.sh verifies the
# archive, extracts it and renames it to KALI_IMG_FILE. The raw image is
# ~25 GiB, already larger than LAB_DISK_GB, and is never shrunk.
#
# The URLs point at the per-release directory, NOT current/, which 404s the
# moment Kali cuts a release. Pick any release listed at
# https://kali.download/cloud-images/ (old ones move to old.kali.org).
KALI_VERSION="2026.2"
KALI_IMG_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/kali-linux-${KALI_VERSION}-cloud-genericcloud-arm64.tar.xz"
KALI_SHA_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/SHA256SUMS"
KALI_IMG_FILE="kali-genericcloud-arm64.raw"

# --- Kali toolset -----------------------------------------------------------
# Which Kali function groups the workstation gets, space separated, WITHOUT the
# kali-tools- prefix. Empty (the default) is a bare Kali with the desktop and
# Mullvad Browser.
#
# Every package is downloaded through the gateway's multihop tunnel, which is
# the point and also why it is slow: a group is 2 to 650 packages (gpu 2,
# detect 11, passwords 279, top10 301, web 609, vulnerability 650).
#
# Groups: 802-11, bluetooth, crypto-stego, database, detect, exploitation,
# forensics, fuzzing, gpu, hardware, identify, information-gathering,
# passwords, post-exploitation, protect, recover, reporting, respond,
# reverse-engineering, rfid, sdr, sniffing-spoofing, social-engineering,
# top10, voip, vulnerability, web, windows-resources, wireless.
#
# The kali-linux-* umbrellas are deliberately NOT selectable: all four pull
# openvpn and vpnc onto a host that must never hold a VPN client, and
# `make verify` would fail on them.
#
# sdr, rfid, bluetooth, hardware and 802-11 install fine but have no device to
# talk to in a VM with one virtual NIC.
KALI_TOOL_GROUPS=""

# --- VM fleet ---------------------------------------------------------------
# Each entry: "name:role [cpu=N] [ram=MiB] [disk=GB]"
#
#   name   short name; the UTM VM is LAB_PREFIX-name, and this is what
#          'make ssh' and the Ansible inventory use
#   role   maps to a base image, a NIC layout, a cloud-init seed and an
#          Ansible group
#
# The gateway MUST be the first entry: its host SSH port is 2300+index, and
# both the workstation's ProxyJump and scripts/verify.sh derive it from index 1.
#
# Changing cpu= or ram= makes the next 'make up' restart that VM; VMs whose
# cpu/ram did not change are never restarted. disk= applies only at creation
# (UTM imports the staged disk into its own bundle), so growing an existing VM
# means 'make destroy' then 'make up'. Disks are never shrunk.
LAB_VMS=(
  "gateway:gateway cpu=2 ram=2048 disk=20"
  "workstation:workstation cpu=4 ram=4096 disk=60"
)
