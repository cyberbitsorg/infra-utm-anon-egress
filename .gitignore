# Downloaded base images (large, fetched on demand)
images/*
!images/.gitkeep

# Generated per-deploy artifacts
generated/
*.seed.iso
cloud-init/*.rendered.yaml

# Ansible inventory generated from running VMs
ansible/inventory/hosts.generated.yaml

# Secrets and local config. The .example files ARE tracked; the real ones never
# are. Belt and braces on .env: ignore every .env* variant, then re-include the
# example, so a .env.local or .env.bak cannot be committed by accident either.
lab.conf
.env*
!.env.example
*.pem
id_ed25519
id_ed25519.pub
.vault_pass
secrets/*
!secrets/.gitkeep
# Same belt-and-braces as .env above. `secrets/*` does NOT cover a sibling copy,
# and a directory of WireGuard configs is exactly the thing an operator makes a
# quick backup of before regenerating keys. secrets_bu/ was found untracked and
# committable during the multihop work; any secrets* variant is now ignored.
secrets*/
!secrets/
*.conf.singlehop.bak

# Logs
*.log
