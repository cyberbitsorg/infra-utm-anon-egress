# Downloaded base images (large, fetched on demand)
images/*
!images/.gitkeep

# Generated per-deploy artifacts
generated/
*.seed.iso
cloud-init/*.rendered.yaml
ansible/inventory/hosts.generated.yaml

# ansible-lint's project-local runtime home, recreated by `make lint`. Empty
# today, but it is where collections get installed: one `git add -A` away from
# vendoring a few thousand files.
.ansible/

# Secrets and local config. The .example files ARE tracked; the real ones never
# are. Belt and braces on both .env and secrets/, because the near-miss is a
# sibling copy (.env.bak, secrets_bu/) that the plain rule does not cover.
lab.conf
.env*
!.env.example
*.pem
id_ed25519
id_ed25519.pub
.vault_pass
secrets/*
!secrets/.gitkeep
secrets*/
!secrets/
*.bak

# Logs
*.log
